    "strings": {
      "lockPurpose": {
        "en": "Keep your notes behind your fingerprint, face or screen lock if you turn the lock on",
        "sk": "Chrániť vaše poznámky odtlačkom prsta, tvárou alebo zámkou obrazovky, ak zámku zapnete"
      },
      "notifyPurpose": {
        "en": "Remind you of a note at the date and time you choose",
        "sk": "Pripomenúť vám poznámku v deň a čas, ktorý si vyberiete"
      },
      "filesPurpose": {
        "en": "Save your notes as a file, or add notes from a file you pick",
        "sk": "Uložiť poznámky do súboru alebo pridať poznámky zo súboru, ktorý vyberiete"
      },
      "widgetPurpose": {
        "en": "Show your pinned and recent notes on the home screen",
        "sk": "Zobraziť pripnuté a nedávne poznámky na ploche"
      },
      "sharePurpose": {
        "en": "Send a note’s text and photos to another app when you tap Share",
        "sk": "Poslať text a fotky poznámky do inej aplikácie, keď ťuknete na Zdieľať"
      },
      "cameraPurpose": {
        "en": "Take a photo to keep in a note",
        "sk": "Odfotiť niečo a uložiť fotku do poznámky"
      },
      "pickPurpose": {
        "en": "Add pictures from your photos to a note",
        "sk": "Pridať do poznámky obrázky z vašich fotiek"
