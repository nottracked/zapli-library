  "permissions": {
    "auth.lock": {
      "purpose": "@lockPurpose",
      "default": "off"
    },
    "notify.local": {
      "purpose": "@notifyPurpose",
      "maxPerDay": 20
    },
    "files.io": {
      "purpose": "@filesPurpose",
      "modes": ["import", "export"]
    },
    "widget.home": {
      "purpose": "@widgetPurpose"
    },
    "share": {
      "purpose": "@sharePurpose"
    },
    "camera.photo": {
      "purpose": "@cameraPurpose",
      "optional": true
    },
    "media.pick": {
      "purpose": "@pickPurpose",
      "optional": true
    },
    "device.ux": {
      "purpose": "@uxPurpose",
      "optional": true
    }
  },
  "dataFlows": [
    {
      "from": ["*"],
      "to": "files.io",
      "purpose": "@filesFlow"
    },
    {
      "from": ["*"],
      "to": "share",
      "purpose": "@shareFlow"
    }
  ],
  "entities": {
    "note": {
      "label": "@note",
      "labelPlural": "@notes",
      "sensitivity": "personal",
      "sort": ["-pinned", "-edited"],
      "display": {
        "title": "=trim(coalesce(item.title, '')) != '' ? item.title : (trim(coalesce(item.body, '')) != '' ? substring(coalesce(first(split(trim(replace(replace(coalesce(item.body, ''), '- [ ] ', ''), '- [x] ', '')), '\\n')), ''), 0, 80) : t('untitled'))",
        "icon": "=item.kind == 'list' ? 'checklist' : 'notes'"
      },
      "fields": {
        "title": {
          "label": "@title",
          "type": "text",
          "maxLength": 1000
        },
        "body": {
          "label": "@text",
          "type": "longText",
          "maxLength": 100000
        },
        "kind": {
          "label": "@kind",
          "type": "choice",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "@textKind",
              "icon": "notes"
            },
            {
              "value": "list",
              "label": "@listKind",
              "icon": "checklist"
            }
          ]
        },
        "color": {
          "label": "@colour",
          "type": "choice",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "@colourNone"
            },
            {
              "value": "red",
              "label": "@red",
              "hue": "red"
            },
            {
              "value": "orange",
              "label": "@orange",
              "hue": "orange"
            },
            {
              "value": "yellow",
              "label": "@yellow",
              "hue": "amber"
            },
            {
              "value": "green",
              "label": "@green",
              "hue": "green"
            },
            {
              "value": "teal",
              "label": "@teal",
              "hue": "teal"
            },
            {
              "value": "blue",
              "label": "@blue",
              "hue": "blue"
            },
            {
              "value": "purple",
              "label": "@purple",
              "hue": "violet"
            },
            {
              "value": "pink",
              "label": "@pink",
              "hue": "pink"
            },
            {
              "value": "brown",
              "label": "@brown",
              "hue": "brown"
            },
            {
              "value": "grey",
              "label": "@grey",
              "hue": "grey"
            }
          ]
        },
        "pinned": {
          "label": "@pinned",
          "type": "boolean",
          "default": false
        },
        "archived": {
          "label": "@archived",
          "type": "boolean",
          "default": false
        },
        "trashedAt": {
          "label": "@trashedAt",
          "type": "datetime"
        },
        "labels": {
          "label": "@labels",
          "type": "text",
          "maxLength": 2000
        },
        "photos": {
          "label": "@photos",
          "type": "text",
          "maxLength": 2000,
          "visible": false
        },
        "created": {
          "label": "@created",
          "type": "datetime"
        },
        "edited": {
          "label": "@edited",
          "type": "datetime"
        },
        "remindAt": {
          "label": "@remindAt",
          "type": "datetime"
        },
        "repeat": {
          "label": "@repeat",
          "type": "recurrence"
        },
        "reminded": {
          "label": "@reminded",
          "type": "datetime",
          "visible": false
        },
        "fresh": {
          "label": "@imported",
          "type": "boolean",
          "default": false,
          "visible": false
        },
        "importId": {
          "label": "@importBatch",
          "type": "text",
          "maxLength": 40,
          "visible": false
        }
      }
    },
    "label": {
      "label": "@label",
      "labelPlural": "@labels",
      "sensitivity": "personal",
      "sort": ["name"],
      "display": {
        "title": "=item.name",
        "icon": "label"
      },
      "fields": {
        "name": {
          "label": "@labelName",
          "type": "text",
          "required": true,
          "unique": true,
          "maxLength": 50
        }
      }
    },
    "prefs": {
      "label": "@prefs",
      "labelPlural": "@prefs",
      "singleton": true,
      "fields": {
        "privateReminders": {
          "label": "@privateReminders",
          "type": "boolean",
          "default": false
        }
      }
    },
    "importLog": {
      "label": "@importLog",
      "labelPlural": "@importLogs",
      "sort": ["-createdAt"],
      "display": {
        "title": "=item.stamp"
      },
      "fields": {
        "stamp": {
          "label": "@importBatch",
          "type": "text",
          "required": true,
          "maxLength": 40
        },
        "skipped": {
          "label": "@skippedRows",
          "type": "integer",
          "default": 0
        },
        "problems": {
          "label": "@problems",
          "type": "longText",
          "maxLength": 5000
        }
      }
    }
  },
  "queries": {
    "prefsAll": {
      "entity": "prefs",
      "limit": 1
    },
    "pinnedNotes": {
      "entity": "note",
      "where": "=item.pinned && !item.archived && item.trashedAt == null",
      "sort": ["-edited"],
      "limit": 8
    },
    "recentNotes": {
      "entity": "note",
      "where": "=!item.archived && item.trashedAt == null",
      "sort": ["-edited"],
      "limit": 8
    },
    "freshNotes": {
      "entity": "note",
      "where": "=item.fresh",
      "limit": 1000
    },
    "labelled": {
      "entity": "note",
      "args": {
        "name": {
          "type": "text",
          "maxLength": 50
        }
      },
      "where": "=contains(', ' + coalesce(item.labels, '') + ', ', ', ' + coalesce(args.name, '') + ', ')",
      "limit": 1000
    }
  },
  "actions": {
    "remindOnce": {
      "args": {
        "note": {
          "type": "ref",
          "to": "note"
        }
      },
      "steps": [
        {
          "type": "capability",
          "capability": "notify.local",
          "action": "show",
          "args": {
            "title": "=coalesce(first(q.prefsAll).privateReminders, false) || trim(coalesce(args.note.title, '')) == '' ? t('reminderTitle') : substring(args.note.title, 0, 90)",
            "body": "=coalesce(first(q.prefsAll).privateReminders, false) ? t('reminderPrivateBody') : substring(replace(replace(replace(trim(coalesce(args.note.body, '')), '- [ ] ', '○ '), '- [x] ', '✓ '), '\\n', '  '), 0, 240)",
            "open": {
              "route": "home"
            },
            "buttons": [
              {
                "id": "done",
                "label": "@doneButton",
                "action": "reminderDone"
              }
            ],
            "snooze": true,
            "data": {
              "note": "=string(args.note.id)"
            },
            "tag": "='note-' + string(args.note.id)",
            "channel": "reminders"
          }
        },
        {
          "type": "updateRecord",
          "record": "=args.note",
          "set": {
            "reminded": "=now()"
          }
        }
      ]
    },
    "remindRepeat": {
      "args": {
        "note": {
          "type": "ref",
          "to": "note"
        }
      },
      "steps": [
        {
          "type": "capability",
          "capability": "notify.local",
          "action": "show",
          "args": {
            "title": "=coalesce(first(q.prefsAll).privateReminders, false) || trim(coalesce(args.note.title, '')) == '' ? t('reminderTitle') : substring(args.note.title, 0, 90)",
            "body": "=coalesce(first(q.prefsAll).privateReminders, false) ? t('reminderPrivateBody') : substring(replace(replace(replace(trim(coalesce(args.note.body, '')), '- [ ] ', '○ '), '- [x] ', '✓ '), '\\n', '  '), 0, 240)",
            "open": {
              "route": "home"
            },
            "snooze": true,
            "tag": "='note-' + string(args.note.id)",
            "channel": "reminders"
          }
        },
        {
          "type": "updateRecord",
          "record": "=args.note",
          "set": {
            "reminded": "=now()"
          }
        }
      ]
    },
    "reminderDone": {
      "args": {
        "note": {
          "type": "ref",
          "to": "note"
        }
      },
      "steps": [
        {
          "type": "updateRecord",
          "when": "=args.note.repeat == null",
          "record": "=args.note",
          "set": {
            "remindAt": "=null"
          }
        }
      ]
    },
    "purgeTrash": {
      "steps": [
        {
          "type": "deleteRecords",
          "entity": "note",
          "where": "=item.trashedAt != null && item.trashedAt < now() - duration('P30D')"
        }
      ]
    },
    "emptyTrash": {
      "steps": [
        {
          "type": "deleteRecords",
          "entity": "note",
          "where": "=item.trashedAt != null"
        }
      ]
    },
    "importNotes": {
      "args": {
        "format": {
          "type": "text",
          "maxLength": 10
        },
        "stamp": {
          "type": "text",
          "maxLength": 40,
          "required": true
        }
      },
      "steps": [
        {
          "type": "capability",
          "capability": "files.io",
          "action": "importCsv",
          "args": {
            "entity": "note",
            "format": "=args.format == 'json' ? 'json' : 'csv'",
            "rowsAt": "/notes",
            "set": {
              "fresh": true
            },
            "onlyRows": [
              {
                "from": ["trashed", "isTrashed", "In trash", "Deleted", "V koši"],
                "except": ["true", "yes", "1", "áno"]
              }
            ],
            "fields": {
              "title": {
                "from": ["title", "Title", "Name", "Subject", "Heading", "Názov", "Nadpis", "Titulok", "Titel"],
                "values": {
                  "*": ""
                }
              },
              "body": {
                "from": [
                  "text",
                  "Text",
                  "Body",
                  "Content",
                  "Contents",
                  "textContent",
                  "Note",
                  "Notes",
                  "Description",
                  "Obsah",
                  "Poznámka",
                  "Poznámky",
                  "Telo"
                ],
                "values": {
                  "*": ""
                }
              },
              "kind": {
                "from": ["kind", "Type", "Note type", "Druh", "Typ"],
                "values": {
                  "text": "text",
                  "note": "text",
                  "plain": "text",
                  "list": "list",
                  "checklist": "list",
                  "todo": "list",
                  "zoznam": "list",
                  "*": ""
                }
              },
              "color": {
                "from": ["color", "Colour", "Color name", "Farba"],
                "values": {
                  "default": "none",
                  "white": "none",
                  "red": "red",
                  "orange": "orange",
                  "yellow": "yellow",
                  "green": "green",
                  "teal": "teal",
                  "cyan": "teal",
                  "blue": "blue",
                  "cerulean": "blue",
                  "dark blue": "blue",
                  "purple": "purple",
                  "violet": "purple",
                  "pink": "pink",
                  "brown": "brown",
                  "gray": "grey",
                  "grey": "grey",
                  "bez farby": "none",
                  "červená": "red",
                  "oranžová": "orange",
                  "žltá": "yellow",
                  "zelená": "green",
                  "tyrkysová": "teal",
                  "modrá": "blue",
                  "fialová": "purple",
                  "ružová": "pink",
                  "hnedá": "brown",
                  "sivá": "grey",
                  "*": "none"
                }
              },
              "pinned": {
                "from": ["pinned", "isPinned", "Pinned", "Starred", "Favourite", "Favorite", "Pripnutá", "Pripnuté"],
                "values": {
                  "*": ""
                }
              },
              "archived": {
                "from": ["archived", "isArchived", "Archived", "Archivovaná", "Archivované"],
                "values": {
                  "*": ""
                }
              },
              "labels": {
                "from": [
                  "labels",
                  "Labels",
                  "Label",
                  "Tags",
                  "Tag",
                  "Category",
                  "Categories",
                  "Folder",
                  "Notebook",
                  "Štítky",
                  "Štítok",
                  "Kategória"
                ],
                "values": {
                  "*": ""
                }
              },
              "created": {
                "from": [
                  "created",
                  "Created",
                  "Created at",
                  "Creation date",
                  "Date created",
                  "createdAt",
                  "creationDate",
                  "Date",
                  "Vytvorená",
                  "Vytvorené",
                  "Dátum"
                ],
                "values": {
                  "*": ""
                }
              },
              "edited": {
                "from": [
                  "edited",
                  "Edited",
                  "Modified",
                  "Last modified",
                  "Date modified",
                  "Updated",
                  "Updated at",
                  "lastModified",
                  "modifiedAt",
                  "Upravená",
                  "Upravené",
                  "Zmenené"
                ],
                "values": {
                  "*": ""
                }
              },
              "remindAt": {
                "from": ["remindAt", "Reminder", "Remind at", "Pripomienka"],
                "values": {
                  "*": ""
                }
              },
              "repeat": {
                "from": ["repeat", "Repeat", "Repeats", "Opakuje sa"],
                "values": {
                  "*": ""
                }
              }
            },
            "onError": "skip"
          },
          "as": "imported"
        },
        {
          "type": "runAction",
          "action": "settleImport",
          "args": {
            "stamp": "=args.stamp"
          }
        },
        {
          "type": "createRecord",
          "entity": "importLog",
          "values": {
            "stamp": "=args.stamp",
            "skipped": "=coalesce(vars.imported.skipped, 0)",
            "problems": "=join(take(vars.imported.problems, 8).map(p, t('problemLine', {'row': p.row, 'reason': p.reason})), '\\n')"
          }
        }
      ]
    },
    "settleImport": {
      "args": {
        "stamp": {
          "type": "text",
          "maxLength": 40,
          "required": true
        }
      },
      "steps": [
        {
          "type": "forEach",
          "query": "freshNotes",
          "do": "settleNote",
          "args": {
            "note": "=item.id",
            "stamp": "=args.stamp"
          },
          "max": 1000
        },
        {
          "type": "forEach",
          "query": "freshNotes",
          "do": "settleNote",
          "args": {
            "note": "=item.id",
            "stamp": "=args.stamp"
          },
          "max": 1000
        },
        {
          "type": "forEach",
          "query": "freshNotes",
          "do": "settleNote",
          "args": {
            "note": "=item.id",
            "stamp": "=args.stamp"
          },
          "max": 1000
        }
      ]
    },
    "settleNote": {
      "args": {
        "note": {
          "type": "ref",
          "to": "note"
        },
        "stamp": {
          "type": "text",
          "maxLength": 40,
          "required": true
        }
      },
      "steps": [
        {
          "type": "updateRecord",
          "record": "=args.note",
          "set": {
            "fresh": false,
            "importId": "=args.stamp",
            "kind": "=args.note.kind == 'list' || matches(coalesce(args.note.body, ''), '^\\\\s*([-*+] )?\\\\[[ xX]\\\\] ') ? 'list' : 'text'",
            "labels": "=replaceAll(trim(coalesce(args.note.labels, '')), '\\\\s*[;|]\\\\s*', ', ')",
            "created": "=coalesce(args.note.created, args.note.edited, now())",
            "edited": "=coalesce(args.note.edited, args.note.created, now())"
          }
        }
      ]
    },
    "undoImport": {
      "args": {
        "stamp": {
          "type": "text",
          "maxLength": 40,
          "required": true
        }
      },
      "steps": [
        {
          "type": "deleteRecords",
          "entity": "note",
          "where": "=item.importId == args.stamp"
        }
      ]
    },
    "renameLabel": {
      "args": {
        "from": {
          "type": "text",
          "maxLength": 50,
          "required": true
        },
        "to": {
          "type": "text",
          "maxLength": 50
        }
      },
      "steps": [
        {
          "type": "forEach",
          "query": "labelled",
          "queryArgs": {
            "name": "=args.from"
          },
          "do": "relabel",
          "args": {
            "note": "=item.id",
            "from": "=args.from",
            "to": "=coalesce(args.to, '')"
          },
          "max": 1000
        },
        {
          "type": "forEach",
          "query": "labelled",
          "queryArgs": {
            "name": "=args.from"
          },
          "do": "relabel",
          "args": {
            "note": "=item.id",
            "from": "=args.from",
            "to": "=coalesce(args.to, '')"
          },
          "max": 1000
        }
      ]
    },
    "relabel": {
      "args": {
        "note": {
          "type": "ref",
          "to": "note"
        },
        "from": {
          "type": "text",
          "maxLength": 50,
          "required": true
        },
        "to": {
          "type": "text",
          "maxLength": 50
        }
      },
      "steps": [
        {
          "type": "updateRecord",
          "record": "=args.note",
          "set": {
            "labels": "=replaceAll(replace(', ' + coalesce(args.note.labels, '') + ', ', ', ' + args.from + ', ', coalesce(args.to, '') == '' ? ', ' : ', ' + coalesce(args.to, '') + ', '), '^(, )+|(, )+$', '')"
          }
        }
      ]
    }
  },
  "triggers": {
    "onceReminder": {
      "type": "recordTime",
      "entity": "note",
      "at": "=item.remindAt",
      "when": "=item.repeat == null && item.trashedAt == null",
      "do": "remindOnce",
      "args": {
        "note": "=item.id"
      },
      "maxPerDay": 10
    },
    "repeatReminder": {
      "type": "recordSchedule",
      "entity": "note",
      "rrule": "=item.repeat",
      "time": "=item.remindAt != null ? time(item.remindAt) : time('09:00')",
      "when": "=item.repeat != null && item.remindAt != null && item.trashedAt == null && item.remindAt <= now() + duration('PT5M')",
      "do": "remindRepeat",
      "args": {
        "note": "=item.id"
      },
      "maxPerDay": 10
    },
    "nightlyTrash": {
      "type": "schedule",
      "rrule": "FREQ=DAILY",
      "times": ["03:30"],
      "do": "purgeTrash",
      "maxPerDay": 1
    },
    "openTrash": {
      "type": "app",
      "on": "open",
      "do": "purgeTrash"
    }
  },
  "widgets": {
    "pinned": {
      "template": "list",
      "title": "@pinnedWidget",
      "query": "pinnedNotes",
      "caption": "=trim(coalesce(item.title, '')) != '' ? substring(replace(replace(replace(trim(coalesce(item.body, '')), '- [ ] ', '○ '), '- [x] ', '✓ '), '\\n', '  '), 0, 120) : ''",
      "icon": "=item.kind == 'list' ? 'checklist' : 'push_pin'",
      "sizes": ["small", "medium", "large"],
      "open": "home"
    },
    "recent": {
      "template": "list",
      "title": "@recentWidget",
      "query": "recentNotes",
      "caption": "=trim(coalesce(item.title, '')) != '' ? substring(replace(replace(replace(trim(coalesce(item.body, '')), '- [ ] ', '○ '), '- [x] ', '✓ '), '\\n', '  '), 0, 120) : ''",
      "icon": "=item.kind == 'list' ? 'checklist' : 'notes'",
      "sizes": ["small", "medium", "large"],
      "open": "home"
    }
  }
}
