{
  "spec": "zapli/0.2",
  "app": {
    "id": "library/loyalty-cards",
    "kind": "web",
    "name": "Loyalty cards",
    "version": "3.1.1",
    "icon": "wallet",
    "category": "shopping",
    "ageRating": "everyone",
    "license": "GPL-3.0-or-later",
    "iconData": ""
  },
  "theme": {
    "seedColor": "#5E35B1",
    "shape": "extraRounded"
  },
  "i18n": {
    "defaultLocale": "en",
    "strings": {
      "scanPurpose": {
        "en": "Add a card by scanning its barcode with the camera",
        "sk": "Pridať kartu naskenovaním jej čiarového kódu fotoaparátom"
      },
      "brightPurpose": {
        "en": "Show a card’s code at full brightness and keep the screen on while it is shown",
        "sk": "Ukázať kód karty pri plnom jase a nechať obrazovku zapnutú, kým je kód zobrazený"
      },
      "showCodePurpose": {
        "en": "Show a card’s code full screen and bright, so the cashier can scan it",
        "sk": "Zobraziť kód karty na celej obrazovke a jasne, aby ho pri pokladni ľahko naskenovali"
      },
      "remindPurpose": {
        "en": "Remind you a week before a card or voucher expires",
        "sk": "Pripomenúť vám týždeň vopred, že sa končí platnosť karty alebo poukážky"
      },
      "filesPurpose": {
        "en": "Back up your cards to a file, or add cards from one",
        "sk": "Zálohovať karty do súboru alebo zo súboru karty pridať"
      },
      "sharePurpose": {
        "en": "Send a card’s code to someone you choose",
        "sk": "Poslať kód karty niekomu, koho vyberiete"
      },
      "widgetPurpose": {
        "en": "Show your favourite cards on your home screen",
        "sk": "Zobraziť obľúbené karty na ploche"
      },
      "pickPurpose": {
        "en": "Read a card from a screenshot or photo, or use a photo as a card’s face",
        "sk": "Načítať kartu zo snímky obrazovky alebo fotky, prípadne použiť fotku ako vzhľad karty"
      },
      "cameraPurpose": {
        "en": "Take a photo of a card’s front or back to keep with it",
        "sk": "Odfotiť prednú alebo zadnú stranu karty a uložiť ju ku karte"
      },
      "filesFlow": {
        "en": "Your cards, saved as a backup file in a place you choose",
        "sk": "Vaše karty sa uložia ako záložný súbor na miesto, ktoré vyberiete"
      },
      "shareFlow": {
        "en": "A card’s code and store, when you tap Share",
        "sk": "Kód a obchod karty, keď klepnete na Zdieľať"
      },
      "endsIn": {
        "en": "Number ending {digits}",
        "sk": "Číslo končí na {digits}"
      },
      "expiredLine": {
        "en": "Expired {date}",
        "sk": "Platnosť skončila {date}"
      },
      "exported": {
        "en": "{n, plural, =0 {Saved an empty file.} one {Saved # card.} other {Saved # cards.}}",
        "sk": "{n, plural, =0 {Uložil sa prázdny súbor.} one {Uložená # karta.} few {Uložené # karty.} many {Uložené # karty.} other {Uložených # kariet.}}"
      },
      "expiryTitle": {
        "en": "{store} card expires soon",
        "sk": "Platnosť karty {store} čoskoro skončí"
      },
      "expiryBody": {
        "en": "It is valid until {date}.",
        "sk": "Platí do {date}."
      },
      "problemLine": {
        "en": "Line {row}: {reason}",
        "sk": "Riadok {row}: {reason}"
      },
      "moreProblems": {
        "en": "{n, plural, one {…and # more row} other {…and # more rows}}",
        "sk": "{n, plural, one {…a ešte # riadok} few {…a ešte # riadky} many {…a ešte # riadka} other {…a ešte # riadkov}}"
      },
      "points": {
        "en": "{n, plural, one {# point} other {# points}}",
        "sk": "{n, plural, one {# bod} few {# body} many {# bodu} other {# bodov}}"
      },
      "balance": {
        "en": "Balance {n}",
        "sk": "Zostatok {n}"
      },
      "card": {
        "en": "Card",
        "sk": "Karta"
      },
      "cards": {
        "en": "Cards",
        "sk": "Karty"
      },
      "store": {
        "en": "Store",
        "sk": "Obchod"
      },
      "cardNumber": {
        "en": "Card number",
        "sk": "Číslo karty"
      },
      "thatIsTooLong": {
        "en": "That is too long for a card number.",
        "sk": "Na číslo karty je to príliš dlhé."
      },
      "ean13Needs12": {
        "en": "EAN-13 needs 12 or 13 digits.",
        "sk": "EAN-13 potrebuje 12 alebo 13 číslic."
      },
      "lastDigitThisEan": {
        "en": "The last digit of this EAN-13 doesn’t match the rest of the number. Check the number.",
        "sk": "Posledná číslica tohto kódu EAN-13 nesedí so zvyškom čísla. Overte číslo."
      },
      "ean8Needs7": {
        "en": "EAN-8 needs 7 or 8 digits.",
        "sk": "EAN-8 potrebuje 7 alebo 8 číslic."
      },
      "lastDigitThisEan2": {
        "en": "The last digit of this EAN-8 doesn’t match the rest of the number. Check the number.",
        "sk": "Posledná číslica tohto kódu EAN-8 nesedí so zvyškom čísla. Overte číslo."
      },
      "upcNeeds1112": {
        "en": "UPC-A needs 11 or 12 digits.",
        "sk": "UPC-A potrebuje 11 alebo 12 číslic."
      },
      "lastDigitThisUpc": {
        "en": "The last digit of this UPC-A doesn’t match the rest of the number. Check the number.",
        "sk": "Posledná číslica tohto kódu UPC-A nesedí so zvyškom čísla. Overte číslo."
      },
      "upcENeeds6": {
        "en": "UPC-E needs 6 digits, or 7 or 8 starting with 0 or 1.",
        "sk": "UPC-E potrebuje 6 číslic, alebo 7 či 8 číslic so začiatočnou 0 alebo 1."
      },
      "lastDigitThisUpc2": {
        "en": "The last digit of this UPC-E doesn’t match the rest of the number. Check the number.",
        "sk": "Posledná číslica tohto kódu UPC-E nesedí so zvyškom čísla. Overte číslo."
      },
      "code39TakesCapital": {
        "en": "Code 39 takes capital letters, digits, spaces and - . $ / + %.",
        "sk": "Code 39 prijíma veľké písmená, číslice, medzery a - . $ / + %."
      },
      "code128TakesPlain": {
        "en": "Code 128 takes plain letters, digits and symbols.",
        "sk": "Code 128 prijíma písmená bez diakritiky, číslice a symboly."
      },
      "code93TakesPlain": {
        "en": "Code 93 takes plain letters, digits and symbols.",
        "sk": "Code 93 prijíma písmená bez diakritiky, číslice a symboly."
      },
      "codabarTakesDigitsWith": {
        "en": "Codabar takes digits and - $ : / . +, with A, B, C or D at both ends or at neither.",
        "sk": "Codabar prijíma číslice a - $ : / . +, s písmenom A, B, C alebo D na oboch koncoch alebo na žiadnom."
      },
      "itfNeedsEvenNumber": {
        "en": "ITF needs an even number of digits, at least 6.",
        "sk": "ITF potrebuje párny počet číslic, aspoň 6."
      },
      "barcodeType": {
        "en": "Barcode type",
        "sk": "Typ čiarového kódu"
      },
      "automatic": {
        "en": "Automatic",
        "sk": "Automaticky"
      },
