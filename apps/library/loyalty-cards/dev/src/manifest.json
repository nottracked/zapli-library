        "en": "Picture of the card",
        "sk": "Obrázok karty"
      },
      "archived": {
        "en": "Archived",
        "sk": "Archivovaná"
      },
      "timesShown2": {
        "en": "Times shown",
        "sk": "Počet zobrazení"
      },
      "lastShown": {
        "en": "Last shown",
        "sk": "Naposledy zobrazená"
      },
      "expired": {
        "en": "Expired",
        "sk": "Platnosť skončila"
      },
      "pinned": {
        "en": "Pinned",
        "sk": "Pripnutá"
      },
      "favourite": {
        "en": "Favourite",
        "sk": "Obľúbená"
      },
      "storeId": {
        "en": "Store in the list",
        "sk": "Obchod v zozname"
      },
      "remind": {
        "en": "Remind me before it expires",
        "sk": "Pripomenúť pred koncom platnosti"
      },
      "importLog": {
        "en": "Import",
        "sk": "Import"
      },
      "importLogs": {
        "en": "Imports",
        "sk": "Importy"
      },
      "importedAt": {
        "en": "Imported",
        "sk": "Importované"
      },
      "added": {
        "en": "Added",
        "sk": "Pridané"
      },
      "duplicates": {
        "en": "Already there",
        "sk": "Už existujúce"
      },
      "skippedRows": {
        "en": "Rows left out",
        "sk": "Vynechané riadky"
      },
      "problems": {
        "en": "Problems",
        "sk": "Problémy"
      },
      "favouriteCards": {
        "en": "Favourite cards",
        "sk": "Obľúbené karty"
      }
    }
  },
  "web": {
    "routes": {
      "wallet": "#/",
      "add": "#/add"
    },
    "orientation": "any"
  },
  "permissions": {
    "scan.barcode": {
      "purpose": "@scanPurpose",
      "formats": [
        "qr",
        "ean13",
        "ean8",
        "upcA",
        "upcE",
        "code128",
        "code39",
        "dataMatrix",
        "pdf417",
        "aztec",
        "codabar",
        "code93",
        "itf"
      ]
    },
    "device.ux": {
      "purpose": "@brightPurpose"
    },
    "barcode.render": {
      "purpose": "@showCodePurpose"
    },
    "notify.local": {
      "purpose": "@remindPurpose",
      "maxPerDay": 3
    },
    "files.io": {
      "purpose": "@filesPurpose",
      "modes": ["import", "export"]
    },
    "share": {
      "purpose": "@sharePurpose"
    },
    "widget.home": {
      "purpose": "@widgetPurpose"
    },
    "media.pick": {
      "purpose": "@pickPurpose",
      "optional": true
    },
    "camera.photo": {
      "purpose": "@cameraPurpose",
      "optional": true
    }
  },
  "dataFlows": [
    {
      "from": ["*"],
      "to": "files.io",
      "purpose": "@filesFlow"
    },
    {
      "from": ["*"],
      "to": "share",
      "purpose": "@shareFlow"
    }
  ],
  "entities": {
    "card": {
      "label": "@card",
      "labelPlural": "@cards",
      "unique": [["store", "number"]],
      "sort": ["-pinned", "-uses", "store"],
      "display": {
        "title": "=item.store",
        "subtitle": "=item.expired ? t('expiredLine', {'date': formatDate(item.expires, 'yMMMd')}) : t('endsIn', {'digits': substring(item.number, max(size(item.number) - 4, 0))})",
        "trailing": "=has(item.points) ? formatNumber(item.points) : ''",
        "icon": "=coalesce(optionIcon(item.group), 'storefront')",
        "tone": "=item.expired ? 'warning' : null"
      },
      "fields": {
        "store": {
          "type": "text",
          "label": "@store",
          "required": true,
          "maxLength": 60,
          "kind": "name"
        },
        "number": {
          "type": "barcode",
          "label": "@cardNumber",
          "required": true,
          "kind": "loyaltyCard",
          "sensitivity": "personal",
          "checks": [
            {
              "condition": "=size(item.number) <= 300",
              "message": "@thatIsTooLong"
            },
            {
              "condition": "=item.format != 'ean13' || item.number.matches(r'^[0-9]{12,13}$')",
              "message": "@ean13Needs12"
            },
            {
              "condition": "=item.format != 'ean13' || !item.number.matches(r'^[0-9]{13}$') || checkDigitValid(item.number, 'ean13')",
              "message": "@lastDigitThisEan"
            },
            {
              "condition": "=item.format != 'ean8' || item.number.matches(r'^[0-9]{7,8}$')",
              "message": "@ean8Needs7"
            },
            {
              "condition": "=item.format != 'ean8' || !item.number.matches(r'^[0-9]{8}$') || checkDigitValid(item.number, 'ean8')",
              "message": "@lastDigitThisEan2"
            },
            {
              "condition": "=item.format != 'upcA' || item.number.matches(r'^[0-9]{11,12}$')",
              "message": "@upcNeeds1112"
            },
            {
              "condition": "=item.format != 'upcA' || !item.number.matches(r'^[0-9]{12}$') || checkDigitValid(item.number, 'upcA')",
              "message": "@lastDigitThisUpc"
            },
            {
              "condition": "=item.format != 'upcE' || item.number.matches(r'^([0-9]{6}|[01][0-9]{6,7})$')",
              "message": "@upcENeeds6"
            },
            {
              "condition": "=item.format != 'upcE' || !item.number.matches(r'^[01][0-9]{7}$') || checkDigitValid(item.number, 'upcE')",
              "message": "@lastDigitThisUpc2"
            },
            {
              "condition": "=item.format != 'code39' || item.number.matches(r'^[0-9A-Z .$/+%-]+$')",
              "message": "@code39TakesCapital"
            },
            {
              "condition": "=item.format != 'code128' || item.number.matches(r'^[ -~]+$')",
              "message": "@code128TakesPlain"
            },
            {
              "condition": "=item.format != 'code93' || item.number.matches(r'^[ -~]+$')",
              "message": "@code93TakesPlain"
            },
            {
              "condition": "=item.format != 'codabar' || item.number.matches(r'^([A-D][0-9$:/.+-]{2,}[A-D]|[0-9$:/.+-]{2,})$')",
              "message": "@codabarTakesDigitsWith"
            },
            {
              "condition": "=item.format != 'itf' || item.number.matches(r'^([0-9][0-9]){3,}$')",
              "message": "@itfNeedsEvenNumber"
            }
          ]
        },
        "format": {
          "type": "choice",
          "label": "@barcodeType",
          "required": true,
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "@automatic",
              "icon": "barcode"
            },
            {
              "value": "code128",
              "label": "Code 128",
              "icon": "barcode"
            },
            {
              "value": "ean13",
              "label": "EAN-13",
              "icon": "barcode"
            },
            {
              "value": "ean8",
              "label": "EAN-8",
              "icon": "barcode"
            },
            {
              "value": "upcA",
              "label": "UPC-A",
              "icon": "barcode"
            },
            {
              "value": "upcE",
              "label": "UPC-E",
              "icon": "barcode"
            },
            {
              "value": "code39",
              "label": "Code 39",
              "icon": "barcode"
            },
            {
              "value": "qr",
              "label": "@qrCode",
              "icon": "qr_code_2"
            },
            {
              "value": "dataMatrix",
              "label": "Data Matrix",
              "icon": "qr_code"
            },
            {
              "value": "pdf417",
              "label": "PDF417",
              "icon": "barcode"
            },
            {
              "value": "aztec",
              "label": "Aztec",
              "icon": "qr_code"
            },
            {
              "value": "codabar",
              "label": "Codabar",
              "icon": "barcode"
            },
            {
              "value": "code93",
              "label": "Code 93",
              "icon": "barcode"
            },
            {
              "value": "itf",
              "label": "ITF (Interleaved 2 of 5)",
              "icon": "barcode"
            }
          ]
        },
        "holder": {
          "type": "text",
          "label": "@nameCard",
          "maxLength": 60,
          "kind": "name",
          "sensitivity": "personal"
        },
        "group": {
          "type": "choice",
          "label": "@kindShop",
          "options": [
            {
              "value": "shopping_cart",
              "label": "@groceries",
              "icon": "shopping_cart",
              "hue": "green"
            },
            {
              "value": "storefront",
              "label": "@shop",
              "icon": "storefront",
              "hue": "indigo"
            },
            {
              "value": "shopping_bag",
              "label": "@clothesShoes",
              "icon": "shopping_bag",
              "hue": "violet"
            },
            {
              "value": "medication",
              "label": "@pharmacy",
              "icon": "medication",
              "hue": "red"
            },
            {
              "value": "spa",
              "label": "@beauty",
              "icon": "spa",
              "hue": "pink"
            },
            {
              "value": "directions_car",
              "label": "@fuelCar",
              "icon": "directions_car",
              "hue": "blue"
            },
            {
              "value": "handyman",
              "label": "@homeDiy",
              "icon": "handyman",
              "hue": "orange"
            },
            {
              "value": "keyboard",
              "label": "@electronics",
              "icon": "keyboard",
              "hue": "grey"
            },
            {
              "value": "menu_book",
              "label": "@books",
              "icon": "menu_book",
              "hue": "amber"
            },
            {
              "value": "restaurant",
              "label": "@foodDrink",
              "icon": "restaurant",
              "hue": "orange"
            },
            {
              "value": "local_cafe",
              "label": "@coffee",
              "icon": "local_cafe",
              "hue": "brown"
            },
            {
              "value": "flight",
              "label": "@travel",
              "icon": "flight",
              "hue": "cyan"
            },
            {
              "value": "fitness_center",
              "label": "@sportGym",
              "icon": "fitness_center",
              "hue": "lime"
            },
            {
              "value": "pets",
              "label": "@pets",
              "icon": "pets",
              "hue": "cyan"
            },
            {
              "value": "child_care",
              "label": "@kids",
              "icon": "child_care",
              "hue": "pink"
            },
            {
              "value": "book",
              "label": "@library",
              "icon": "book",
              "hue": "teal"
            },
            {
              "value": "badge",
              "label": "@membership",
              "icon": "badge",
              "hue": "indigo"
            },
            {
              "value": "sell",
              "label": "@voucherGiftCard",
              "icon": "sell",
              "hue": "violet"
            }
          ]
        },
        "points": {
          "type": "number",
          "label": "@pointsBalance",
          "min": 0
        },
        "expires": {
          "type": "date",
          "label": "@validUntil"
        },
        "note": {
          "type": "longText",
          "label": "@note",
          "maxLength": 500
        },
        "color": {
          "type": "color",
          "label": "@colour"
        },
        "picture": {
          "type": "image",
          "label": "@pictureCard"
        },
        "pinned": {
          "type": "boolean",
          "label": "@favourite",
          "default": false
        },
        "archived": {
          "type": "boolean",
          "label": "@archived",
          "default": false
        },
        "uses": {
          "type": "integer",
          "label": "@timesShown2",
          "default": 0,
          "min": 0,
          "merge": "counter",
          "editable": false
        },
        "lastUsed": {
          "type": "datetime",
          "label": "@lastShown",
          "editable": false
        },
        "brand": {
          "type": "text",
          "label": "@storeId",
          "maxLength": 40
        },
        "remind": {
          "type": "boolean",
          "label": "@remind",
          "default": true
        },
        "expired": {
          "type": "boolean",
          "label": "@expired",
          "compute": "=has(item.expires) && item.expires < today()"
        }
      }
    },
    "importLog": {
      "label": "@importLog",
      "labelPlural": "@importLogs",
      "sort": ["-at"],
      "display": {
        "title": "=formatDate(item.at, 'yMMMd')"
      },
      "fields": {
        "at": {
          "type": "datetime",
          "label": "@importedAt",
          "required": true
        },
        "added": {
          "type": "integer",
          "label": "@added",
          "default": 0
        },
        "duplicates": {
          "type": "integer",
          "label": "@duplicates",
          "default": 0
        },
        "skipped": {
          "type": "integer",
          "label": "@skippedRows",
          "default": 0
        },
        "problems": {
          "type": "longText",
          "label": "@problems",
          "maxLength": 5000
        }
      }
    }
  },
  "queries": {
    "top": {
      "entity": "card",
      "where": "=!item.archived",
      "sort": ["-pinned", "-uses", "-lastUsed", "store"],
      "limit": 5
    },
    "allCards": {
      "entity": "card",
      "sort": ["store"],
      "limit": 2000
    }
  },
  "actions": {
    "screenOn": {
      "args": {
        "on": {
          "type": "boolean",
          "required": true
        }
      },
      "steps": [
        {
          "type": "capability",
          "capability": "device.ux",
          "action": "keepScreenOn",
          "args": {
            "enabled": "=args.on"
          },
          "onError": "continue"
        },
        {
          "type": "capability",
          "capability": "device.ux",
          "action": "maxBrightness",
          "args": {
            "enabled": "=args.on"
          }
        }
      ]
    },
    "showCode": {
      "args": {
        "card": {
          "type": "ref",
          "to": "card",
          "required": true
        },
        "format": {
          "type": "text",
          "required": true
        }
      },
      "steps": [
        {
          "type": "capability",
          "capability": "barcode.render",
          "action": "show",
          "args": {
            "value": "=args.card.number",
            "format": "=args.format",
            "title": "=args.card.store"
          },
          "onError": "continue",
          "errorAs": "showError"
        },
        {
          "type": "toast",
          "when": "=vars.showError != null && vars.showError.code != 'CANCELLED'",
          "text": "=coalesce(vars.showError.message, '')"
        }
      ]
    },
    "markUsed": {
      "args": {
        "card": {
          "type": "ref",
          "to": "card",
          "required": true
        }
      },
      "steps": [
        {
          "type": "updateRecord",
          "record": "=args.card",
          "increment": {
            "uses": 1
          },
          "set": {
            "lastUsed": "=now()"
          }
        }
      ]
    },
    "exportCards": {
      "steps": [
        {
          "type": "capability",
          "capability": "files.io",
          "action": "exportCsv",
          "args": {
            "query": "allCards",
            "fileName": "='cards-' + string(today()) + '.csv'",
            "columns": [
              "store",
              "number",
              "format",
              "holder",
              "group",
              "points",
              "expires",
              "note",
              "pinned",
              "archived",
              "brand",
              "remind"
            ]
          },
          "as": "saved"
        },
        {
          "type": "toast",
          "when": "=vars.saved.saved",
          "text": "=t('exported', {'n': coalesce(vars.saved.rows, 0)})"
        }
      ]
    },
    "importCards": {
      "steps": [
        {
          "type": "capability",
          "capability": "files.io",
          "action": "importCsv",
          "args": {
            "entity": "card",
            "fields": {
              "store": {
                "from": ["Store", "Shop", "Merchant", "Store name", "Retailer", "Obchod"]
              },
              "number": {
                "from": [
                  "barcodeid",
                  "cardid",
                  "Card number",
                  "Card ID",
                  "Number",
                  "Member number",
                  "Membership number",
                  "Code",
                  "Barcode",
                  "Číslo karty"
                ]
              },
              "format": {
                "from": ["Barcode type", "Barcode format", "Format", "Typ čiarového kódu"],
                "values": {
                  "*": "auto",
                  "Automatic": "auto",
                  "Automaticky": "auto",
                  "QR code": "qr",
                  "QR kód": "qr",
                  "ITF (Interleaved 2 of 5)": "itf"
                }
              },
              "holder": {
                "from": ["Name on the card", "Card holder", "Holder", "Meno na karte"]
              },
              "group": {
                "values": {
                  "Groceries": "shopping_cart",
                  "Potraviny": "shopping_cart",
                  "Shop": "storefront",
                  "Obchod": "storefront",
                  "Clothes and shoes": "shopping_bag",
                  "Oblečenie a obuv": "shopping_bag",
                  "Pharmacy": "medication",
                  "Lekáreň": "medication",
                  "Beauty": "spa",
                  "Kozmetika": "spa",
                  "Fuel and car": "directions_car",
                  "Palivo a auto": "directions_car",
                  "Home and DIY": "handyman",
                  "Domácnosť a hobby": "handyman",
                  "Electronics": "keyboard",
                  "Elektronika": "keyboard",
                  "Books": "menu_book",
                  "Knihy": "menu_book",
                  "Food and drink": "restaurant",
                  "Jedlo a nápoje": "restaurant",
                  "Coffee": "local_cafe",
                  "Káva": "local_cafe",
                  "Travel": "flight",
                  "Cestovanie": "flight",
                  "Sport and gym": "fitness_center",
                  "Šport a fitnes": "fitness_center",
                  "Zvieratá": "pets",
                  "Kids": "child_care",
                  "Deti": "child_care",
                  "Library": "book",
                  "Knižnica": "book",
                  "Membership": "badge",
                  "Členstvo": "badge",
                  "Voucher or gift card": "sell",
                  "Poukážka alebo darčeková karta": "sell",
                  "Kozmetika a drogéria": "spa",
                  "Pets": "pets"
                },
                "from": ["Kind of shop", "Group", "Category", "Druh obchodu"]
              },
              "points": {
                "from": ["Points or balance", "Points", "Balance", "Body alebo zostatok"]
              },
              "expires": {
                "from": ["Valid until", "Expiry date", "Expiry", "Expires", "Platná do"]
              },
              "note": {
                "from": ["Note", "Notes", "Comment", "Poznámka"]
              },
              "pinned": {
                "from": [
                  "Favourite",
                  "Obľúbená",
                  "Pin to the top",
                  "Pripnúť navrch",
                  "starstatus",
                  "Favorite",
                  "Starred"
                ]
              },
              "archived": {
                "from": ["Archived", "archive", "Archivovaná"]
              },
              "lastUsed": {
                "from": ["Last shown", "lastused", "Last used", "Naposledy zobrazená"],
                "values": {
                  "0": ""
                }
              },
              "brand": {
                "from": ["Store in the list", "Obchod v zozname", "Brand"]
              },
              "remind": {
                "from": ["Remind me before it expires", "Pripomenúť pred koncom platnosti"]
              }
            },
            "onDuplicate": "skip",
            "key": ["store", "number"],
            "onError": "skip"
          },
          "as": "imported"
        },
        {
          "type": "createRecord",
          "entity": "importLog",
          "values": {
            "at": "=now()",
            "added": "=vars.imported.added",
            "duplicates": "=vars.imported.duplicates",
            "skipped": "=vars.imported.skipped",
            "problems": "=join(take(vars.imported.problems, 8).map(p, t('problemLine', {'row': p.row, 'reason': p.reason})), '\\n') + (vars.imported.skipped > 8 ? '\\n' + t('moreProblems', {'n': vars.imported.skipped - 8}) : '')"
          }
        }
      ]
    },
    "remindExpiry": {
      "args": {
        "card": {
          "type": "ref",
          "to": "card"
        }
      },
      "steps": [
        {
          "type": "capability",
          "capability": "notify.local",
          "action": "show",
          "args": {
            "title": "=t('expiryTitle', {'store': args.card.store})",
            "body": "=t('expiryBody', {'date': formatDate(args.card.expires, 'yMMMd')})",
            "open": {
              "route": "wallet"
            },
            "tag": "='expiry-' + string(args.card.id)",
            "channel": "expiry"
          }
        }
      ]
    }
  },
  "triggers": {
    "expirySoon": {
      "type": "recordTime",
      "entity": "card",
      "at": "=has(item.expires) ? timestamp(string(addDays(item.expires, -7)) + 'T09:00') : null",
      "ifPast": "now",
      "when": "=coalesce(item.remind, true) && has(item.expires) && item.expires >= today() && !item.archived",
      "do": "remindExpiry",
      "args": {
        "card": "=item.id"
      },
      "maxPerDay": 3
    }
  },
  "widgets": {
    "topCards": {
      "template": "list",
      "title": "@favouriteCards",
      "sizes": ["medium", "large"],
      "query": "top",
      "label": "=item.store",
      "caption": "=coalesce(item.holder, '') != '' ? coalesce(item.holder, '') : t('endsIn', {'digits': substring(item.number, max(size(item.number) - 4, 0))})",
      "icon": "=coalesce(optionIcon(item.group), 'storefront')",
      "open": "wallet"
    }
  }
}
