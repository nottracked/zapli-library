      },
      "voucherGiftCard": {
        "en": "Voucher or gift card",
        "sk": "Poukážka alebo darčeková karta"
      },
      "pointsBalance": {
        "en": "Points or balance",
        "sk": "Body alebo zostatok"
      },
      "validUntil": {
        "en": "Valid until",
        "sk": "Platná do"
      },
      "note": {
        "en": "Note",
        "sk": "Poznámka"
      },
