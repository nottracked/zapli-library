  "theme": { "seedColor": "#5E3A8C" },
  "i18n": {
    "defaultLocale": "en",
    "strings": {
      "purposeHaptics": {
        "en": "A light tap on each key and a short buzz when you find the word",
        "sk": "Jemné ťuknutie pri každom klávese a krátke zavibrovanie, keď slovo uhádnete"
      },
      "purposeShare": {
        "en": "Send your result in words, such as found in 4 of 6, when you tap Share",
        "sk": "Poslať výsledok slovami, napríklad uhádnuté na 4. pokus zo 6, keď klepnete na Zdieľať"
      },
      "flowShare": {
        "en": "Sends your result in words to the app you pick, never the word or your guesses",
        "sk": "Pošle váš výsledok slovami do aplikácie, ktorú vyberiete, nikdy nie slovo ani vaše pokusy"
      }
    }
  },
  "permissions": {
    "device.ux": { "purpose": "@purposeHaptics" },
    "share": { "purpose": "@purposeShare" }
  },
  "dataFlows": [{ "from": ["*"], "to": "share", "purpose": "@flowShare" }],
